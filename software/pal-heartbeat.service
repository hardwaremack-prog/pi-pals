# Install:
#   sudo cp pal-heartbeat.py /usr/local/bin/ && sudo chmod +x /usr/local/bin/pal-heartbeat.py
#   sudo cp pal-heartbeat.service /etc/systemd/system/
#   sudo systemctl enable --now pal-heartbeat
# Needs SPI turned on (sudo raspi-config -> Interface Options -> SPI) and:
#   sudo pip3 install --break-system-packages adafruit-circuitpython-neopixel-spi

[Unit]
Description=Pi Pal heartbeat LED
After=local-fs.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/pal-heartbeat.py
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
